#!/bin/bash

# 0. Fast-path: bypass splash if Steam is already running or control flags are passed
if pgrep -f "steamwebhelper" >/dev/null 2>&1 || [[ " $* " =~ [[:space:]](-shutdown|-exit|-checkforupdates)[[:space:]] ]]; then
  exec flatpak run com.valvesoftware.Steam "$@"
fi

# 1. Gamescope environment detection & fast 20ms basemap handshake
export DISPLAY="${DISPLAY:-:0}"
ZENITY_FLAGS=()

if pgrep -x gamescope >/dev/null 2>&1 || [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] || [ "$WAYLAND_DISPLAY" = "gamescope-0" ]; then
  ZENITY_FLAGS=(
    "--nosocket=wayland"
    "--socket=x11"
    "--env=GDK_BACKEND=x11"
    "--env=DISPLAY=$DISPLAY"
    "--env=GDK_SCALE=4"
  )
  (
    xprop -root -f GAMESCOPECTRL_BASELAYER_APPID 32c -set GAMESCOPECTRL_BASELAYER_APPID 769
    for _ in {1..400}; do
      if xprop -name "Steam" WM_CLASS 2>/dev/null | grep -qiE "zenity|com\.valvesoftware\.Steam"; then
        xprop -name "Steam" -f STEAM_GAME 32c -set STEAM_GAME 769
        break
      fi
      sleep 0.02
    done
  ) >/dev/null 2>&1 &
fi

# 2. In-memory FIFO setup and cleanup handlers
BOOT_LOG="$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/logs/bootstrap_log.txt"
FEED="/tmp/zenity_feed_$$"
rm -f "$FEED"
mkfifo "$FEED"
exec 4<> "$FEED"
rm -f "$FEED"

dismiss_zenity() {
  STEAM_READY=1
  pkill -P "$PARSER_PID" 2>/dev/null
  kill "$PARSER_PID" 2>/dev/null
  printf "pulsate:false\n100\n" >&4 2>/dev/null
  exec 4>&- 2>/dev/null
  sleep 0.1
  pkill -x "zenity" 2>/dev/null
  kill "$ZENITY_PID" 2>/dev/null
}

cleanup() {
  dismiss_zenity
  pkill -P $$ 2>/dev/null
}
trap cleanup EXIT INT TERM

# 3. Follow Steam's bootstrap_log.txt
(
  echo "pulsate:true" >&4
  re_dl='Downloading update \(([0-9,]+) of ([0-9,]+) KB\)'

  stdbuf -oL tail -n 0 -F "$BOOT_LOG" 2>/dev/null | while IFS= read -r line; do
    if [[ "$line" =~ $re_dl ]]; then
      cur="${BASH_REMATCH[1]//,/}"
      tot="${BASH_REMATCH[2]//,/}"
      if [ "$tot" -gt 0 ] 2>/dev/null; then
        pct=$(( cur * 100 / tot ))
        [ "$pct" -ge 100 ] && pct=99
        printf -v pad "%3d" "$pct"
        printf "pulsate:false\n%s\n# [%s%%] Downloading update (%s of %s KB)...\n" \
          "$pct" "$pad" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >&4
      fi
    elif [[ "$line" =~ (Verifying\ installation|Extracting\ package|Installing\ update) ]]; then
      printf "pulsate:true\n# %s...\n" "${BASH_REMATCH[1]}" >&4
    elif [[ "$line" =~ (Verification|Update)\ complete|Steam\ is\ up\ to\ date|Destroy\ window ]]; then
      printf "pulsate:true\n# Starting Steam...\n" >&4
    fi
  done
) &
PARSER_PID=$!

# 4. Launch Zenity and Steam (FD 4 passed as stdin on the host side)
flatpak run \
  "${ZENITY_FLAGS[@]}" \
  --command=sh com.valvesoftware.Steam -c '
    exec -a com.valvesoftware.Steam zenity \
      --progress \
      --title="Steam" \
      --text="Checking for available updates..." \
      --percentage=0 \
      --width=500 \
      --auto-close \
      --cancel-label="Cancel"
  ' <&4 4>&- >/dev/null 2>&1 &
ZENITY_PID=$!

flatpak run com.valvesoftware.Steam "$@" 4>&- &
STEAM_PID=$!

# 5. Wait for a real Steam window to map in either Gamescope or Desktop Mode
is_steam_window_open() {
  xprop -name "SP" WM_CLASS >/dev/null 2>&1 && return 0
  local wid class
  for wid in $(xprop -root _NET_CLIENT_LIST GAMESCOPE_FOCUSABLE_WINDOWS 2>/dev/null | sed -n 's/.*[=#]//p' | grep -oE '(0x[0-9a-fA-F]+|[0-9]+)'); do
    class=$(xprop -id "$wid" WM_CLASS 2>/dev/null)
    if echo "$class" | grep -qi "steam" && ! echo "$class" | grep -qiE "zenity|valvesoftware"; then
      return 0
    fi
  done
  return 1
}

STEAM_READY=0
while kill -0 "$STEAM_PID" 2>/dev/null; do
  if is_steam_window_open; then
    dismiss_zenity
    break
  fi

  if ! kill -0 "$ZENITY_PID" 2>/dev/null; then
    wait "$ZENITY_PID" 2>/dev/null
    if [ "$?" -ne 0 ] && [ "$STEAM_READY" -eq 0 ]; then
      flatpak kill com.valvesoftware.Steam 2>/dev/null
      pkill -9 -f "com.valvesoftware.Steam" 2>/dev/null
      exit 1
    fi
    break
  fi

  sleep 0.1
done

wait "$STEAM_PID" 2>/dev/null
