#!/bin/sh

EXTERNAL_DISPLAYS=""
PREFER_VK=""

for status in /sys/class/drm/*/status; do
  [ -f "$status" ] || continue
  if [ "$(cat "$status" 2>/dev/null)" = "connected" ]; then
    conn=$(basename "$(dirname "$status")")
    card="${conn%%-*}"
    conn_name="${conn#card*-}"
    case "$conn_name" in
      eDP*|LVDS*|DSI*|Writeback*|Virtual*)
        ;;
      *)
        if [ -z "$EXTERNAL_DISPLAYS" ]; then
          EXTERNAL_DISPLAYS="$conn_name"
        else
          EXTERNAL_DISPLAYS="$EXTERNAL_DISPLAYS,$conn_name"
        fi
        if [ -z "$PREFER_VK" ] && [ -d "/sys/class/drm/$card/device" ]; then
          v=$(cat "/sys/class/drm/$card/device/vendor" 2>/dev/null)
          d=$(cat "/sys/class/drm/$card/device/device" 2>/dev/null)
          if [ -n "$v" ] && [ -n "$d" ]; then
            PREFER_VK="${v#0x}:${d#0x}"
          fi
        fi
        ;;
    esac
  fi
done

GAMESCOPE_ARGS=""
if [ -n "$PREFER_VK" ]; then
  GAMESCOPE_ARGS="--prefer-vk-device $PREFER_VK"
fi
if [ -n "$EXTERNAL_DISPLAYS" ]; then
  GAMESCOPE_ARGS="$GAMESCOPE_ARGS -O $EXTERNAL_DISPLAYS"
fi

# Run Gamescope cleanly without the invalid --wayland-socket-name flag
exec gamescope $GAMESCOPE_ARGS --hdr-enabled --mangoapp -e -f -- sh -c '
  if [ -n "$DESKTOP_SESSION_ID" ]; then
    /usr/bin/loginctl lock-session $DESKTOP_SESSION_ID 2>/dev/null &
  fi

  if [ -n "$MANGOHUD_CONFIGFILE" ]; then
    SANDBOX_XDG="$XDG_RUNTIME_DIR/.flatpak/com.valvesoftware.Steam/xdg-run"
    mkdir -p "$SANDBOX_XDG"
    CONFIG_NAME="$(basename "$MANGOHUD_CONFIGFILE")"
    SANDBOX_CONFIG="$SANDBOX_XDG/$CONFIG_NAME"
    cp -f "$MANGOHUD_CONFIGFILE" "$SANDBOX_CONFIG" 2>/dev/null || touch "$SANDBOX_CONFIG"
    ln -sf "$SANDBOX_CONFIG" "$MANGOHUD_CONFIGFILE"
  fi

  /usr/bin/steam -steamos3 "$@"

  if [ -n "$ORIG_VT" ]; then
    sudo /usr/bin/chvt "$ORIG_VT" 2>/dev/null || true
  fi
' _ "$@"
