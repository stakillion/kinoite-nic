#!/bin/sh

export GAMESCOPE_WSI_HIDE_PRESENT_WAIT_EXT=1
export VKD3D_DISABLE_EXTENSIONS="VK_KHR_present_wait"

EXTERNAL_DISPLAYS=""
PREFER_VK=""
WATCH_FILES=""

for status in /sys/class/drm/*/status; do
  [ -f "$status" ] || continue
  if [ "$(cat "$status" 2>/dev/null)" = "connected" ]; then
    conn=$(basename "$(dirname "$status")")
    card="${conn%%-*}"
    conn_name="${conn#card*-}"
    case "$conn_name" in
      eDP*|LVDS*|DSI*|Writeback*|Virtual*)
        ;;
      *)
        if [ -z "$EXTERNAL_DISPLAYS" ]; then
          EXTERNAL_DISPLAYS="$conn_name"
        else
          EXTERNAL_DISPLAYS="$EXTERNAL_DISPLAYS,$conn_name"
        fi
        if [ -z "$PREFER_VK" ] && [ -d "/sys/class/drm/$card/device" ]; then
          v=$(cat "/sys/class/drm/$card/device/vendor" 2>/dev/null)
          d=$(cat "/sys/class/drm/$card/device/device" 2>/dev/null)
          if [ -n "$v" ] && [ -n "$d" ]; then
            PREFER_VK="${v#0x}:${d#0x}"
          fi
        fi
        WATCH_FILES="$WATCH_FILES $status"
        ;;
    esac
  fi
done

GAMESCOPE_ARGS=""
if [ -n "$PREFER_VK" ]; then
  GAMESCOPE_ARGS="--prefer-vk-device $PREFER_VK"
fi
if [ -n "$EXTERNAL_DISPLAYS" ]; then
  GAMESCOPE_ARGS="$GAMESCOPE_ARGS -O $EXTERNAL_DISPLAYS --force-composition"
fi

if [ -n "$WATCH_FILES" ]; then
  gamescope $GAMESCOPE_ARGS --hdr-enabled --mangoapp -e -f -- steam -steamos3 "$@" &
  GAMESCOPE_PID=$!

  # Watch for external display disconnect and request clean Steam shutdown
  (
    while kill -0 "$GAMESCOPE_PID" 2>/dev/null; do
      sleep 0.3
      for f in $WATCH_FILES; do
        if [ ! -f "$f" ] || [ "$(cat "$f" 2>/dev/null)" != "connected" ]; then
          steam -shutdown 2>/dev/null
          exit 0
        fi
      done
    done
  ) &
  WATCHER_PID=$!

  trap 'steam -shutdown 2>/dev/null; kill "$WATCHER_PID" 2>/dev/null' TERM INT HUP

  wait "$GAMESCOPE_PID" 2>/dev/null
  EXIT_CODE=$?
  kill "$WATCHER_PID" 2>/dev/null
  wait "$WATCHER_PID" 2>/dev/null
  exit $EXIT_CODE
else
  exec gamescope $GAMESCOPE_ARGS --hdr-enabled --mangoapp -e -f -- steam -steamos3 "$@"
fi
